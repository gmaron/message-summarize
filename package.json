{
  "name": "message-summarize",
  "version": "0.1.0-rc1",
  "description": "Summarizes the conversations of a messaging account with an LLM and delivers a periodic digest to your own chat.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmaron/message-summarize.git"
  },
  "homepage": "https://github.com/gmaron/message-summarize#readme",
  "bugs": {
    "url": "https://github.com/gmaron/message-summarize/issues"
  },
  "keywords": [
    "whatsapp",
    "summary",
    "digest",
    "llm",
    "baileys",
    "cli"
  ],
  "author": "Gaston Maron",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.es.md",
    "THIRD_PARTY_NOTICES.md",
    "vendor/sharp-stub"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "msum": "dist/main/cli.js",
    "message-summarize": "dist/main/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.web.json && node scripts/svelte-check.cjs --tsconfig tsconfig.web.json --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build --config vite.web.config.ts",
    "eval:ollama": "node test/eval/run.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "notices": "node scripts/check-licenses.mjs --notices",
    "notices:check": "node scripts/check-licenses.mjs --notices --check",
    "check:web-size": "node scripts/check-web-size.mjs",
    "check:spec": "node scripts/check-spec-ids.mjs",
    "prepack": "npm run build && npm run check:dist",
    "prepublishOnly": "node scripts/check-licenses.mjs --strict",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.1.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "croner": "11.0.1",
    "qrcode": "1.5.4",
    "sharp": "file:vendor/sharp-stub"
  }
}

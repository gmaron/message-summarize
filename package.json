{
  "name": "message-summarize",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "msum": "dist/main/cli.js",
    "message-summarize": "dist/main/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.web.json && node scripts/svelte-check.cjs --tsconfig tsconfig.web.json --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build --config vite.web.config.ts",
    "eval:ollama": "node test/eval/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.1.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "croner": "11.0.1",
    "qrcode": "1.5.4"
  }
}
